PORT=3000
NODE_ENV=development
# dynamodb es el modo predeterminado. Para ejemplos temporales: npm run dev:demo.
STORAGE_MODE=dynamodb
AWS_REGION=us-east-2
DYNAMODB_TABLE=SolicitudesAsistencia
# Local: preferir un perfil configurado fuera del repositorio.
# AWS_PROFILE=default
# En Render: configurar las credenciales en Environment; nunca en Git.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN= (solo para credenciales temporales)
# Acceso HTTP Basic: opcional en local; ambos obligatorios en producción.
# DEMO_USER=
# DEMO_PASSWORD=
